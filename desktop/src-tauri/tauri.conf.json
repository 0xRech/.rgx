{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RGX Desktop",
  "version": "0.5.0-alpha2",
  "identifier": "de.rechgroup.rgx.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RGX Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rech Group",
    "homepage": "https://rgx.rech-group.de/",
    "shortDescription": "Compact, private and verifiable RGX archives."
  }
}
